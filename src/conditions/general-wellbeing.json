  "solutions": [
    {
      "id": "gen-sol-1",
      "title": "Guided Breathing",
      "purpose": "A quick 5-minute paced breathing exercise to center yourself.",
      "type": "breathing",
      "durationSeconds": 300,
      "recommendedSoundId": "ocean",
      "instructions": [
        "Inhale quietly for 4 seconds.",
        "Hold gently for 4 seconds.",
        "Exhale smoothly for 6 seconds."
      ]
    },
    {
      "id": "gen-sol-2",
      "title": "Grounding Exercise",
      "purpose": "Anchor awareness in the present moment.",
      "type": "grounding",
      "durationSeconds": 300,
      "instructions": [
        "Focus on 5 things you can see.",
        "4 things you can feel.",
        "3 things you can hear.",
        "2 things you can smell.",
        "1 thing you can taste."
      ]
    },
    {
      "id": "gen-sol-3",
      "title": "Guided Meditation",
      "purpose": "A peaceful 5-minute mindfulness session.",
      "type": "meditation",
      "durationSeconds": 300,
      "recommendedSoundId": "ambient",
      "instructions": [
        "Sit comfortably and rest your gaze.",
        "Focus gently on the breath.",
        "Let thoughts pass without clinging."
      ]
    },
    {
      "id": "gen-sol-4",
      "title": "Gentle Reset",
      "purpose": "Short physical stretch and posture check.",
      "type": "movement",
      "durationSeconds": 180,
      "instructions": [
        "Roll your shoulders back.",
        "Stretch your arms overhead.",
        "Take a slow deep breath."
      ]
    },
    {
      "id": "gen-sol-5",
      "title": "Mind-Clearing",
      "purpose": "Quiet reflection and settling thoughts.",
      "type": "mind-clearing",
      "durationSeconds": 300,
      "recommendedSoundId": "rain",
      "instructions": [
        "Sit quietly for 5 minutes.",
        "Enjoy a moment of stillness."
      ]
    }
  ]
