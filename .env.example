# ---------------------------------------------------------------------------
# Supabase configuration
# Copy this file to .env.local and fill in your project values.
# NEVER commit .env.local to version control.
# ---------------------------------------------------------------------------

# Found in: Supabase Dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Found in: Supabase Dashboard → Project Settings → API → anon / public key
# This is the safe public key — it is NOT the service-role key.
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ---------------------------------------------------------------------------
# NEVER put the service-role key here or anywhere in the frontend.
# The service-role key bypasses RLS and must only be used in server-side code.
# ---------------------------------------------------------------------------

# ===========================================================================
# AI API keys — SERVER-SIDE ONLY (Supabase Edge Function secrets)
# These are NOT prefixed with VITE_ and are never exposed to the browser.
#
# Set them as Supabase Edge Function secrets:
#   supabase secrets set GEMINI_API_KEY=your-key
#   supabase secrets set GROQ_API_KEY=your-key
#
# For local Edge Function development (supabase functions serve):
#   Add to supabase/.env.local (never commit that file)
# ===========================================================================

# Google Gemini API key
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Groq API key (fallback model)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Supabase service-role key — only needed inside Edge Functions, never in frontend
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
