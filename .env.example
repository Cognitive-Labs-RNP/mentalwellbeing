# ---------------------------------------------------------------------------
# Supabase configuration
# Copy this file to .env.local and fill in your project values.
# NEVER commit .env.local to version control.
# ---------------------------------------------------------------------------

# Found in: Supabase Dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Found in: Supabase Dashboard → Project Settings → API → anon / public key
# This is the safe public key — it is NOT the service-role key.
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ---------------------------------------------------------------------------
# NEVER put the service-role key here or anywhere in the frontend.
# The service-role key bypasses RLS and must only be used in server-side code.
# ---------------------------------------------------------------------------
